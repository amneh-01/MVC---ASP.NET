﻿
<!DOCTYPE html>

<html>
<head>
    <meta name="viewport" content="width=device-width" />
    <title>University Cafeteria</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
          rel="stylesheet" />
</head>
<body>
    <header class="bg-primary text-white p-3">
        <h2>University Cafeteria</h2>

        <nav>
            <a href="/Cafeteria/Index" class="text-white me-3">Home</a>
            <a href="/Cafeteria/Products" class="text-white me-3">Products</a>
            <a href="/Cafeteria/Suppliers" class="text-white me-3">Suppliers</a>
            <a href="/Cafeteria/SupplyStatus" class="text-white">Supply Status</a>
        </nav>
    </header>
    <main class="container mt-4">
        @RenderBody()
    </main>
    <footer class="bg-dark text-white text-center p-3 mt-5">
        University Cafeteria - All Rights Reserved
    </footer>

    @RenderSection("Scripts", required: false)
</body>
</html>