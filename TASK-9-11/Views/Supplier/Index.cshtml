@model List<Supplier>

<div class="d-flex justify-content-between align-items-center my-3">
    <h1 class="h3 mb-0">Suppliers</h1>
    <a class="btn btn-success" asp-action="Create">+ Create New Supplier</a>
</div>

<div class="table-responsive">
    <table class="table table-striped table-hover align-middle">
        <thead class="table-dark">
            <tr>
                <th>Id</th>
                <th>Name</th>
                <th>Phone</th>
                <th>Email</th>
                <th class="text-center">Products Count</th>
                <th class="text-end">Actions</th>
            </tr>
        </thead>
        <tbody>
            @if (Model.Count == 0)
            {
                <tr>
                    <td colspan="6" class="text-center text-muted py-4">No suppliers found.</td>
                </tr>
            }
            @foreach (var supplier in Model)
            {
                <tr>
                    <td>@supplier.Id</td>
                    <td class="fw-semibold">@supplier.Name</td>
                    <td>@supplier.Phone</td>
                    <td>@supplier.Email</td>
                    <td class="text-center"><span class="badge bg-secondary">@supplier.Products.Count</span></td>
                    <td class="text-end text-nowrap">
                        <a class="btn btn-sm btn-outline-info" asp-action="Details" asp-route-id="@supplier.Id">Details</a>
                        <a class="btn btn-sm btn-outline-primary" asp-action="Edit" asp-route-id="@supplier.Id">Edit</a>
                        <a class="btn btn-sm btn-outline-danger" asp-action="Delete" asp-route-id="@supplier.Id">Delete</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>