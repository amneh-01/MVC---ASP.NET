@model List<Category>

<div class="d-flex justify-content-between align-items-center my-3">
    <h1 class="h3 mb-0">Categories</h1>
    <a class="btn btn-success" asp-action="Create">+ Create New Category</a>
</div>

<div class="table-responsive">
    <table class="table table-striped table-hover align-middle">
        <thead class="table-dark">
            <tr>
                <th>Id</th>
                <th>Name</th>
                <th>Description</th>
                <th class="text-center">Products Count</th>
                <th class="text-end">Actions</th>
            </tr>
        </thead>
        <tbody>
            @if (Model.Count == 0)
            {
                <tr>
                    <td colspan="5" class="text-center text-muted py-4">No categories found.</td>
                </tr>
            }
            @foreach (var category in Model)
            {
                <tr>
                    <td>@category.Id</td>
                    <td class="fw-semibold">@category.Name</td>
                    <td>@category.Description</td>
                    <td class="text-center"><span class="badge bg-secondary">@category.Products.Count</span></td>
                    <td class="text-end text-nowrap">
                        <a class="btn btn-sm btn-outline-info" asp-action="Details" asp-route-id="@category.Id">Details</a>
                        <a class="btn btn-sm btn-outline-primary" asp-action="Edit" asp-route-id="@category.Id">Edit</a>
                        <a class="btn btn-sm btn-outline-danger" asp-action="Delete" asp-route-id="@category.Id">Delete</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>