@model Order
<h1>Order Details</h1><dl class="row"><dt class="col-sm-2">Customer</dt><dd class="col-sm-10">@Model.CustomerName</dd><dt class="col-sm-2">Date</dt><dd class="col-sm-10">@Model.OrderDate.ToShortDateString()</dd><dt class="col-sm-2">Total</dt><dd class="col-sm-10">@Model.TotalPrice</dd><dt class="col-sm-2">Status</dt><dd class="col-sm-10">@Model.Status</dd><dt class="col-sm-2">Employee</dt><dd class="col-sm-10">@Model.Employee?.FullName</dd></dl><a asp-action="Edit" asp-route-id="@Model.Id">Edit</a> | <a asp-action="Index">Back</a>
