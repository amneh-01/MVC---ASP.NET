@model Order
<h1>Add Order</h1><form asp-action="Create" method="post"><div asp-validation-summary="ModelOnly" class="text-danger"></div><div class="mb-3"><label asp-for="CustomerName"></label><input asp-for="CustomerName" class="form-control" /></div><div class="mb-3"><label asp-for="OrderDate"></label><input asp-for="OrderDate" type="date" class="form-control" /></div><div class="mb-3"><label asp-for="TotalPrice"></label><input asp-for="TotalPrice" class="form-control" /></div><div class="mb-3"><label asp-for="Status"></label><input asp-for="Status" class="form-control" /></div><div class="mb-3"><label asp-for="EmployeeId">Employee</label><select asp-for="EmployeeId" asp-items="ViewBag.Employees" class="form-select"><option value="">Select employee</option></select></div><button class="btn btn-primary">Save</button> <a asp-action="Index">Back</a></form>
