@model List<Order>
<h1>Orders</h1><p><a asp-action="Create" class="btn btn-success">Add Order</a></p><table class="table"><thead><tr><th>Customer</th><th>Date</th><th>Total</th><th>Status</th><th>Employee</th><th></th></tr></thead><tbody>
@foreach (var item in Model) { <tr><td>@item.CustomerName</td><td>@item.OrderDate.ToShortDateString()</td><td>@item.TotalPrice</td><td>@item.Status</td><td>@item.Employee?.FullName</td><td><a asp-action="Details" asp-route-id="@item.Id">Details</a> | <a asp-action="Edit" asp-route-id="@item.Id">Edit</a> | <a asp-action="Delete" asp-route-id="@item.Id">Delete</a></td></tr> }
</tbody></table>
