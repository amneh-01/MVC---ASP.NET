@model Product

<form method="post" asp-action="Create">
    @Html.LabelFor(m => m.Name)<br />
    @Html.TextBoxFor(m => m.Name)
    <br /><br />
    @Html.LabelFor(m => m.Description)<br />
    @Html.TextBoxFor(m => m.Description)
    <br /><br />
    @Html.LabelFor(m => m.Price)<br />
    @Html.TextBoxFor(m => m.Price)
    <br /><br />
    @Html.LabelFor(m => m.Quantity)<br />
    @Html.TextBoxFor(m => m.Quantity)
    <br /><br />
    <div>
        <label asp-for="CategoryId">Category</label>
        <select asp-for="CategoryId" asp-items="(SelectList)ViewBag.Categories"></select>
    </div>

    <div>
        <label asp-for="SupplierId">Supplier</label>
        <select asp-for="SupplierId" asp-items="(SelectList)ViewBag.Suppliers"></select>
    </div>

   
    <button type="submit">Add Category</button>
</form>

