@model List<Product>

<div class="d-flex justify-content-between align-items-center my-3">
    <h1 class="h3 mb-0">Products</h1>
    <a class="btn btn-success" asp-action="Create">+ Create New Product</a>
</div>

<div class="table-responsive">
    <table class="table table-striped table-hover align-middle">
        <thead class="table-dark">
            <tr>
                <th>Id</th>
                <th>Name</th>
                <th class="text-end">Price</th>
                <th class="text-center">Quantity</th>
                <th class="text-center">Stock</th>
                <th>Category</th>
                <th>Supplier</th>
                <th class="text-end">Actions</th>
            </tr>
        </thead>
        <tbody>
            @if (Model.Count == 0)
            {
                <tr>
                    <td colspan="8" class="text-center text-muted py-4">No products found.</td>
                </tr>
            }
            @foreach (var product in Model)
            {
                <tr>
                    <td>@product.Id</td>
                    <td class="fw-semibold">@product.Name</td>
                    <td class="text-end">@product.Price.ToString("0.00")</td>
                    <td class="text-center">@product.Quantity</td>
                    <td class="text-center">
                        @if (product.Quantity < 5)
                        {
                            <span class="badge bg-danger badge-danger text-white">Low Stock</span>
                        }
                        else
                        {
                            <span class="badge bg-success badge-success text-white">In Stock</span>
                        }
                    </td>
                    <td>@product.CategoryId</td>
                    <td>@product.SupplierId</td>
                    <td class="text-end text-nowrap">
                        <a class="btn btn-sm btn-outline-info" asp-action="Details" asp-route-id="@product.Id">Details</a>
                        <a class="btn btn-sm btn-outline-primary" asp-action="Edit" asp-route-id="@product.Id">Edit</a>
                        <a class="btn btn-sm btn-outline-danger" asp-action="Delete" asp-route-id="@product.Id">Delete</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>