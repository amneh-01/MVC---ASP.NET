@model Employee
<h1>Add Employee</h1><form asp-action="Create" method="post"><div asp-validation-summary="ModelOnly" class="text-danger"></div>
<div class="mb-3"><label asp-for="FullName"></label><input asp-for="FullName" class="form-control" /></div><div class="mb-3"><label asp-for="Phone"></label><input asp-for="Phone" class="form-control" /></div><div class="mb-3"><label asp-for="Email"></label><input asp-for="Email" class="form-control" /></div><div class="mb-3"><label asp-for="Position"></label><input asp-for="Position" class="form-control" /></div><div class="mb-3"><label asp-for="Salary"></label><input asp-for="Salary" class="form-control" /></div><div class="mb-3"><label asp-for="HireDate"></label><input asp-for="HireDate" type="date" class="form-control" /></div><button class="btn btn-primary">Save</button> <a asp-action="Index">Back</a></form>
