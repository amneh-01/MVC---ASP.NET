@model List<Employee>
<h1>Employees</h1><p><a asp-action="Create" class="btn btn-success">Add Employee</a></p><table class="table"><thead><tr><th>Name</th><th>Phone</th><th>Email</th><th>Position</th><th>Salary</th><th>Hire Date</th><th></th></tr></thead><tbody>
@foreach (var item in Model) { <tr><td>@item.FullName</td><td>@item.Phone</td><td>@item.Email</td><td>@item.Position</td><td>@item.Salary</td><td>@item.HireDate.ToShortDateString()</td><td><a asp-action="Details" asp-route-id="@item.Id">Details</a> | <a asp-action="Edit" asp-route-id="@item.Id">Edit</a> | <a asp-action="Delete" asp-route-id="@item.Id">Delete</a></td></tr> }
</tbody></table>
