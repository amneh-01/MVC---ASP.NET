@model Employee
<h1>Employee Details</h1><dl class="row"><dt class="col-sm-2">Name</dt><dd class="col-sm-10">@Model.FullName</dd><dt class="col-sm-2">Phone</dt><dd class="col-sm-10">@Model.Phone</dd><dt class="col-sm-2">Email</dt><dd class="col-sm-10">@Model.Email</dd><dt class="col-sm-2">Position</dt><dd class="col-sm-10">@Model.Position</dd><dt class="col-sm-2">Salary</dt><dd class="col-sm-10">@Model.Salary</dd><dt class="col-sm-2">Hire Date</dt><dd class="col-sm-10">@Model.HireDate.ToShortDateString()</dd></dl><a asp-action="Edit" asp-route-id="@Model.Id">Edit</a> | <a asp-action="Index">Back</a>
