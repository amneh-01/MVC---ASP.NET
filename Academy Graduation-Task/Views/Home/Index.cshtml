@model IEnumerable<dynamic>

@{
    ViewData["Title"] = "Graduation Supply Management";
}

<div class="container mt-4">
    <h2 class="text-center text-primary mb-3">Orange Coding Academy - Graduation Ceremony Supplies</h2>
    <p class="text-center text-muted">Please select exactly one offer from each category below:</p>

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger text-center">@TempData["Error"]</div>
    }

    <form asp-action="SaveSelections" method="post">
        
        <!-- Category 1: Graduation Certificates -->
        <h4 class="mt-4 text-secondary">1. Graduation Certificates</h4>
        <table class="table table-bordered table-striped">
            <thead class="table-dark">
                <tr>
                    <th>Select</th>
                    <th>Supplier</th>
                    <th>Offer Name</th>
                    <th>Quantity</th>
                    <th>Unit Price</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    @if (item.CategoryName == "Graduation Certificates")
                    {
                        <tr>
                            <td><input type="radio" name="certOfferId" value="@item.Id" required /></td>
                            <td>@item.SupplierName</td>
                            <td>@item.OfferName</td>
                            <td>@item.Quantity</td>
                            <td>@item.UnitPrice JD</td>
                        </tr>
                    }
                }
            </tbody>
        </table>

        <!-- Category 2: Hospitality -->
        <h4 class="mt-4 text-secondary">2. Hospitality</h4>
        <table class="table table-bordered table-striped">
            <thead class="table-dark">
                <tr>
                    <th>Select</th>
                    <th>Supplier</th>
                    <th>Offer Name</th>
                    <th>Quantity</th>
                    <th>Unit Price</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    @if (item.CategoryName == "Hospitality")
                    {
                        <tr>
                            <td><input type="radio" name="hospitalityOfferId" value="@item.Id" required /></td>
                            <td>@item.SupplierName</td>
                            <td>@item.OfferName</td>
                            <td>@item.Quantity</td>
                            <td>@item.UnitPrice JD</td>
                        </tr>
                    }
                }
            </tbody>
        </table>

        <!-- Category 3: Graduation Gifts -->
        <h4 class="mt-4 text-secondary">3. Graduation Gifts</h4>
        <table class="table table-bordered table-striped">
            <thead class="table-dark">
                <tr>
                    <th>Select</th>
                    <th>Supplier</th>
                    <th>Offer Name</th>
                    <th>Quantity</th>
                    <th>Unit Price</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    @if (item.CategoryName == "Graduation Gifts")
                    {
                        <tr>
                            <td><input type="radio" name="giftOfferId" value="@item.Id" required /></td>
                            <td>@item.SupplierName</td>
                            <td>@item.OfferName</td>
                            <td>@item.Quantity</td>
                            <td>@item.UnitPrice JD</td>
                        </tr>
                    }
                }
            </tbody>
        </table>

        <div class="text-center mt-4 mb-5">
            <button type="submit" class="btn btn-success btn-lg px-5">Review Order & Calculate Cost</button>
        </div>
    </form>
</div>